TARGETS = ["Novak Djokovic","Carlos Alcaraz"]

# Full-point baseline per server
spw_base = (pts.groupby("server_name")["server_win"]
              .agg(wins="sum", plays="size")
              .assign(SPW_base=lambda d: 100*d.wins/d.plays))[["SPW_base"]]

# Server × returner full-point SE, then DSE_full
spw_pair = (pts.groupby(["server_name","returner_name"])["server_win"]
              .agg(wins="sum", plays="size")
              .assign(SPW_pair=lambda d: 100*d.wins/d.plays)
              .join(spw_base, on="server_name")
              .assign(DSE_full=lambda d: d.SPW_base - d.SPW_pair)
              .reset_index()
              .rename(columns={"server_name":"server","returner_name":"returner"}))

panel_a = (spw_pair[spw_pair["returner"].isin(TARGETS)]
           .groupby("returner")
           .apply(lambda g: pd.Series({
               "pairs_used": g.shape[0],
               "plays": int(g["plays"].sum()),
               "DSE_full": np.average(g["DSE_full"], weights=g["plays"])
           })).reset_index())

print("A) Full-point DSE (server point-win%):")
