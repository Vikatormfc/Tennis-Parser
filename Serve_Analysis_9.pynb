import numpy as np
import pandas as pd

TARGETS = ["Novak Djokovic","Carlos Alcaraz"]

# 1) pair-level component counts (per server–returner)
pair_comp = (
    serve_df
      .groupby(["server","returner"], observed=True)
      .agg(plays=("serve_num","size"),
           ace=("ace","sum"),
           unret=("unret","sum"),
           sp1=("sp_plus1","sum"))
      .reset_index()
)

# 2) server baselines for each component – keep ONLY the rates to avoid suffixes
base_comp = (
    serve_df
      .groupby("server", observed=True)
      .agg(plays=("serve_num","size"),
           ace=("ace","sum"),
           unret=("unret","sum"),
           sp1=("sp_plus1","sum"))
      .assign(
          ace_rate   = lambda d: 100 * d.ace   / d.plays,
          unret_rate = lambda d: 100 * d.unret / d.plays,
          sp1_rate   = lambda d: 100 * d.sp1   / d.plays
      )[["ace_rate","unret_rate","sp1_rate"]]   # ← keep only rates
      .reset_index()
)

# 3) join + pair rates + deltas
pc = pair_comp.merge(base_comp, on="server", how="left")
pc = pc.assign(
    ace_pair   = lambda x: 100 * x["ace"]   / x["plays"],
    unret_pair = lambda x: 100 * x["unret"] / x["plays"],
    sp1_pair   = lambda x: 100 * x["sp1"]   / x["plays"],
    d_ace      = lambda x: x["ace_rate"]    - x["ace_pair"],
    d_unret    = lambda x: x["unret_rate"]  - x["unret_pair"],
    d_sp1      = lambda x: x["sp1_rate"]    - x["sp1_pair"],
)

# 4) compact comparison table (no apply warning)
def component_table(returner: str) -> pd.Series:
    g = pc.loc[pc["returner"] == returner, ["server","plays","d_ace","d_unret","d_sp1"]].copy()
    g["wDSE"] = g["d_ace"] + g["d_unret"] + g["d_sp1"]
    out = (g.groupby(level=0)
             .apply(lambda df: pd.Series()) )  # noop, just placeholder to avoid confusion
    w = g["plays"].to_numpy(float)
    return pd.Series({
        "pairs_used": g["server"].nunique(),
        "plays": int(w.sum()),
        "Δace":   np.average(g["d_ace"],   weights=w),
        "Δunret": np.average(g["d_unret"], weights=w),
        "Δsp1":   np.average(g["d_sp1"],   weights=w),
        "a-DSE":  np.average(g["wDSE"],    weights=w),
    }, name=returner)

# Print Djokovic vs Alcaraz
res = pd.concat([component_table(t) for t in TARGETS], axis=1).T.round(3)
print(res.sort_values("a-DSE", ascending=False).to_string(index=False))

