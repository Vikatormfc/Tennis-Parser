# ── Pressure-point flag ───────────────────────────────
POINT_MAP = {"0": 0, "15": 1, "30": 2, "40": 3,"AD": 4, "A": 4, "Adv": 4, "adv": 4, "ADV": 4, "Advantage": 4}

# ── Score bucket (server-centric) ──────────────────────────
def make_score_bucket(r):
    L, R = r.Pts.split("-")
    return f"{L}-{R}" if r.Svr == 1 else f"{R}-{L}"

if "score_bucket" not in pts.columns:
    pts["score_bucket"] = pts.apply(make_score_bucket, axis=1)



def _score_to_int(s):
    """Return numeric value for any tennis score token."""
    s = str(s).strip().upper()
    if s in POINT_MAP:  # 0/15/30/40/AD variants
        return POINT_MAP[s]
    try:
        return int(s)   # tiebreak numeric like '5'
    except ValueError:
        return np.nan

def _is_tiebreak_row(r):
    """Check if the row is a tiebreak point."""
    if "TB?" in r.index:
        tbq = str(r["TB?"]).strip().upper()
        if tbq in {"1","TRUE","T"}:
            return True
    return bool(r.TbSet) and str(r.Gm1).strip() == "6" and str(r.Gm2).strip() == "6" #

def pressure_pt(r):
    # 1) Any tiebreak point is pressure
    if _is_tiebreak_row(r):
        return True

    # 2) Parse game score tokens
    try:
        l_raw, r_raw = str(r.Pts).split("-")
    except ValueError:
        return False  # malformed score → not pressure

    p1, p2 = _score_to_int(l_raw), _score_to_int(r_raw)

    # 3) Symmetric pressure: 30–30 or 40–40 (deuce)
    if p1 == p2 and p1 in (2, 3):
        return True

    # 4) Asymmetric pressure: server is trailing (break-point style)
    #    Pts is in Player1–Player2 terms; Svr==1 means Player1 is serving.
    if r.Svr:     # Player1 serving
        return p1 < p2
    else:         # Player2 serving
        return p2 < p1

pts["pressure_pt"] = pts.apply(pressure_pt, axis=1)



# ───── 1. CONSTANTS & DATACLASS ─────
@dataclass
class Shot:
    hitter: str
    stroke: str
    pos_mod: Optional[str] = None
    net_cord: bool = False
    sector: Optional[str] = None
    err: str = ""
    out: str = ""

STROKE_LABEL = {
    "f": "Forehand",  "b": "Backhand",
    "s": "Backhand slice",  "r": "Forehand slice",
    "v": "Forehand volley", "z": "Backhand volley",
    "o": "Forehand overhead", "p": "Backhand overhead",
    "u": "Forehand drop shot", "y": "Backhand drop shot",
    "l": "Forehand lob", "m": "Backhand lob",
    "h": "Forehand half-volley", "i": "Backhand half-volley",
    "j": "Forehand swinging volley", "k": "Backhand swinging volley",
    "t": "Tweener / trick shot", "q": "Unknown stroke",
    "S": "Serve"
}
SERVE_DIR = {"4": "Wide", "5": "Body", "6": "Down-the-T", "0": "Unknown"}
ERR_LABEL = {"n": "net", "w": "wide", "d": "deep", "x": "wide_deep",
             "g": "foot fault", "!": "shank", "e": "unknown", "": ""}
OUTCOME_LABEL = {"*": "Winner", "#": "Forced error",
                 "@": "Unforced error", "": ""}
SPECIAL_CODES = {
    'S': 'Point to Server', 'R': 'Point to Returner',
    'P': 'Point Penalty on Server','Q': 'Point Penalty on Returner',
    'C': 'Incorrect Challenge',  'V': 'Time Violation on Serve'
}


# ───── 2. ROBUST PARSER ─────
def parse_point(code: str) -> Tuple[Optional[str], List[Shot]]:
    code = str(code).strip()
    if not code:
        return None, []
    if code in SPECIAL_CODES:
        return None, [Shot("System", code, err=SPECIAL_CODES[code])]
    for sc, lbl in SPECIAL_CODES.items():
        if code.endswith(sc):
            return None, [Shot("System", sc, err=lbl)]

    code = code.lstrip('c')  # strip lets

    # serve token
    dir_code, serve_pos_mod, rest = None, None, code
    if code and code[0] in SERVE_DIR:
        dir_code, rest = code[0], code[1:]
        if rest.startswith("+"):
            serve_pos_mod, rest = "+", rest[1:]

    serve_err, serve_out = "", ""
    if dir_code is None and len(rest) == 1 and rest in ERR_LABEL:
        serve_err, rest = rest, ""
    elif rest and len(rest) == 1:
        if rest[0] in ERR_LABEL:
            serve_err, rest = rest[0], ""
        elif rest[0] in OUTCOME_LABEL:
            serve_out, rest = rest[0], ""

    shots: List[Shot] = [Shot("srv", "S", serve_pos_mod, False,
                              dir_code, serve_err, serve_out)]

    # rally tokens
    server_turn, idx = False, 0
    while idx < len(rest):
        if rest[idx] not in STROKE_LABEL:
            break
        stroke = rest[idx]
        next_idx = len(rest)
        for i in range(idx+1, len(rest)):
            if rest[i] in STROKE_LABEL:
                next_idx = i
                break

        token = rest[idx+1:next_idx]
        modifiers = re.findall(r'[;\+\-\=\^]', token)
        digits    = "".join(re.findall(r'\d', token))
        err       = "".join(re.findall(r'[nwdxge]', token))
        outcome   = "".join(re.findall(r'[\*@#]', token))

        shots.append(Shot(
            hitter="srv" if server_turn else "ret",
            stroke=stroke,
            pos_mod=next((c for c in modifiers if c in "+-=^"), None),
            net_cord=';' in modifiers,
            sector=digits or None,
            err=err.lower(),
            out=outcome
        ))

        idx = next_idx
        server_turn = not server_turn
        if outcome:
            break

    return dir_code, shots
Fixating who is a server that wins the point and who is the shooter who wins it
# map PtWinner → actual player name
pts["winner_name"] = np.where(pts["PtWinner"].astype(str).str.strip().eq("1"), pts["player1"],
                              np.where(pts["PtWinner"].astype(str).str.strip().eq("2"), pts["player2"], np.nan))

# did the server win this point?
pts["server_win"] = (pts["server_name"] == pts["winner_name"]).astype("uint8")  # keeps 0/1


# ───── 3. FLAG LOGIC ─────
isUnret = "isUnret" in pts.columns  # define once, outside make_flags

def make_flags(row):
    shots = row["shots"]
    if not shots:
        return pd.Series({"is_ace": False, "is_unret": False, "is_sp1": False})

    ace = (shots[0].out == '*')

    if isUnret:
        unret = bool(str(row.get("isUnret")).strip().upper() == "TRUE")
    else:
        # treat any failed return (forced # or unforced @) as unreturned serve
        unret = (
        (len(shots) == 1 and shots[0].out == "#") or
        (len(shots) >= 2 and shots[1].hitter == "ret" and shots[1].out == "#")
        )


    sp1 = (
        len(shots) == 3 and
        shots[1].hitter == "ret" and shots[1].out == "" and
        shots[2].hitter == "srv" and shots[2].out == "*"
    )

    return pd.Series({"is_ace": ace, "is_unret": unret, "is_sp1": sp1})

def tag_return(row):
    sh = row.shots
    if len(sh) < 2:      # ace or unreturned
        return pd.Series(dict(
            rtn_played  = False,
            rtn_winner  = False,
            rtn_forced  = False,
            rtn_unforce = False,
            rtn_dir     = None
        ))
    rtn = sh[1]
    return pd.Series(dict(
        rtn_played  = True,
        rtn_winner  = rtn.out == '*',
        rtn_forced  = rtn.out == '#',
        rtn_unforce = rtn.out == '@',
        rtn_dir     = rtn.sector      # raw 1-9; map later if desired
    ))



# ───── 4. MAIN PIPELINE ─────

# 1) extract raw rally code
def extract_code(v):
    s = str(v).strip()
    return "" if s.lower()=="nan" or not s else s

pts["raw_code"] = pts.apply(
    lambda r: extract_code(r["2nd"]) or extract_code(r["1st"]),
    axis=1
)

# 2) parse the full shots list
pts["shots"] = pts["raw_code"].map(lambda c: parse_point(c)[1])

# 3) compute serve flags (ace/unret/sp1)
pts = pd.concat([pts, pts.apply(make_flags, axis=1)], axis=1)

# 4) compute return flags (now that shots exists)
pts = pd.concat([pts, pts.apply(tag_return, axis=1)], axis=1)

def safe_point_side(row):
    s = str(row["Pts"])
    if "-" not in s:
        return None  # malformed; skip
    left, right = [t.strip().upper() for t in s.split("-", 1)]
    try:
        p1 = POINT_MAP.get(left, int(left))   # tiebreak numbers like '5'
        p2 = POINT_MAP.get(right, int(right))
    except ValueError:
        return None
    return "deuce" if (p1 + p2) % 2 == 0 else "ad"


# ---------------------------------------------------------
# H2  Tiny lexer for ONE serve attempt
# ---------------------------------------------------------
def lex_serve(token:str):
    """
    Return (dir_code, err_code, out_code).
    Works for the short tokens found in `1st` or `2nd`.
    """
    token = str(token).strip()
    if not token:
        return None, "", ""

    dir_code, err_code, out_code = None, "", ""
    if token[0] in SERVE_DIR:           # 4/5/6/0
        dir_code, token = token[0], token[1:]

    # exactly one trailing symbol at most
    if token and token[0] in ERR_LABEL:
        err_code = token[0]
    elif token and token[0] in OUTCOME_LABEL:
        out_code = token[0]

    return dir_code, err_code, out_code

pts["side"] = pts.apply(safe_point_side, axis=1)

pts[["dir1","err1","out1"]] = pts["1st"].map(lex_serve).tolist()
pts[["dir2","err2","out2"]] = pts["2nd"].map(lex_serve).tolist()

# ─── 3-A explode into serve_df ──────────────────────────



records_serve = []
for _, r in pts.iterrows():
    start_on = 1 if r.err1 == "" else 2  # which serve attempt began the rally
    # now r.server_name, r.shots, r.is_sp1, r.side, r.dir1… all exist
    side    = r.side
    surface = r.Surface
    round_  = r.Round

    # first serve
    d1,e1,o1 = r.dir1, r.err1, r.out1
    records_serve.append({
        "match_id":  r.match_id,
        "server":    r.server_name,
        "server_hand": r.server_hand,
        "returner_hand": r.returner_hand,
        "score_bucket": r.score_bucket,
        "pressure_pt":  r.pressure_pt,
        "returner":  (r.player2 if r.server_name==r.player1 else r.player1),
        "serve_num": 1,
        "side":      side,
        "surface":   surface,
        "round":     round_,
        "dir_code":  d1,
        "err_code":  e1,
        "out_code":  o1,
        "ace":       (o1=="*"),
        "unret":     (o1=="#") or (bool(r.rtn_forced) and start_on == 1),
        "sp_plus1": (r.is_sp1 and start_on == 1)
    })

    # second serve if first was a fault
    if e1:
        d2,e2,o2 = r.dir2, r.err2, r.out2
        records_serve.append({
            **records_serve[-1],
            "serve_num": 2,
            "dir_code":  d2,
            "err_code":  e2,
            "out_code":  o2,
            "ace":       (o2=="*"),
            "unret":     (o2=="#") or (bool(r.rtn_forced) and start_on == 2),
            "sp_plus1":  (r.is_sp1 and start_on == 2)
        })

serve_df = pd.DataFrame(records_serve)
# ────────────────────────────────────────────────────────

# ── 3-B Empirical Serve Efficiency by player + context ────────────
serve_df["is_win"] = (serve_df["ace"] | serve_df["unret"] | serve_df["sp_plus1"]).astype(int)

# group by server + the six dims you ship to the site
empSE_df = (
    serve_df
      .groupby(
          ["server",
           "surface","side","serve_num","pressure_pt","returner_hand"],
          observed=True
      )
      .agg(serves=("is_win","size"), wins=("is_win","sum"))
      .reset_index()
)

# shrink toward the global mean
mu = empSE_df["wins"].sum() / empSE_df["serves"].sum()
m  = 30
empSE_df["empSE_shrunk"] = (empSE_df["wins"] + m*mu) / (empSE_df["serves"] + m)

# merge back only the shrunken SE and serve counts
serve_df = serve_df.merge(
    empSE_df[
      ["server",
       "surface","side","serve_num","pressure_pt","returner_hand",
       "serves","empSE_shrunk"]
    ],
    on=["server","surface","side","serve_num","pressure_pt","returner_hand"],
    how="left"
)

# Most-recent serves first
serve_df = serve_df.sort_values("match_id", ascending=False)

# quick peek
serve_df.head(10)

serve_df.to_csv("serve_stats.csv", index=False)
pts[["raw_code","shots","is_ace","rtn_played","side","dir1","out1"]].head()

# SERVE SUMMARY
# ── 4-A Player summary for the Serve tab ───────────────────────────
serve_summary = (
    serve_df
      .groupby("server")
      .agg(
        total_serves=("serve_num","size"),
        total_aces  =("ace",      "sum"),
        total_unret =("unret",    "sum"),
        total_sp1   =("sp_plus1","sum")
      )
      .assign(
        ace_rate   = lambda d: d.total_aces  / d.total_serves,
        unret_rate = lambda d: d.total_unret / d.total_serves,
        sp1_rate   = lambda d: d.total_sp1   / d.total_serves,
        SE         = lambda d: d.ace_rate + d.unret_rate + d.sp1_rate
      )
)
