SLICE_CODES   = {"s","r"}     # BH slice 's', FH slice 'r'
DROP_CODES    = {"y","u"}     # BH drop 'y', FH drop 'u'
VOLLEY_CODES  = {"v","z","o","p","h","i","j","k"} 
