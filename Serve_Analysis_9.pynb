# 1.  Decide the context dimensions you care about  ─────────────────
#     (dir_code is now included)
CTX_COLS = [
    "server",          # ← row owner
    "dir_code",        # serve direction 4/5/6/0
    "surface",         # Clay / Grass / Hard
    "side",            # deuce / ad
    "serve_num",       # 1 = first serve, 2 = second
    "pressure_pt",     # True / False
    "returner_hand"    # L / R / NaN
]

# ────────────────────────────────────────────────────────────────────
# 2.  Aggregate → compute rates → SE  ───────────────────────────────
serve_cube_full = (
    serve_df
      .groupby(CTX_COLS, observed=True)       # observed=True = skip empty bins
      .agg(
          serves      = ("serve_num", "size"),     # total attempts
          aces        = ("ace",       "sum"),
          unreturned  = ("unret",     "sum"),
          sp_plus1    = ("sp_plus1",  "sum"),
      )
      .assign(
          ace_rate    = lambda d: d.aces       / d.serves,
          unret_rate  = lambda d: d.unreturned / d.serves,
          sp1_rate    = lambda d: d.sp_plus1   / d.serves,
          SE          = lambda d: d.ace_rate + d.unret_rate + d.sp1_rate
      )
      .reset_index()           # keep it *long* for easy filtering on the site
)

# (optional) throw out rows with very small sample size
serve_cube_full = serve_cube_full.query("serves >= 20")

# ────────────────────────────────────────────────────────────────────
# 3.  Export  ────────────────────────────────────────────────────────
