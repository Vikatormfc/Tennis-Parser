missing = req - set(serve_df.columns)
assert not missing, f"serve_df missing columns: {missing}"

def qa_unret_sources(returner):
    sub = serve_df[serve_df["returner"] == returner].copy()
    # infer mapping source
    src = []
    for _, r in sub.iterrows():
        # serve-token unret if the out_code itself is '#'
        if r["out_code"] == "#":
            src.append("serve-token")
        else:
            # otherwise it came from shots[1] forced (#) mapped to the starting serve
            src.append("return-token")
    sub["unret_src"] = src
    tbl = (sub.assign(unret_cnt=sub["unret"].astype(int))
               .groupby("unret_src")["unret_cnt"].sum())
    print(f"\nUnreturned serves by source – {returner}")
    print(tbl)

qa_unret_sources("Novak Djokovic")
qa_unret_sources("Carlos Alcaraz")

def dse_vs_threshold(returner, mins=(0,100,250,500,1000,2000)):
    base = (serve_df.groupby("server")
                   .agg(SE_base=("is_win", lambda s: 100*s.mean()),
                        plays=("is_win","size")))
    pair = (serve_df[serve_df["returner"]==returner]
                   .groupby("server")
                   .agg(SE_pair=("is_win", lambda s: 100*s.mean()),
                        plays_pair=("is_win","size")))
    j = pair.join(base, how="inner")
    for m in mins:
        jj = j[j["plays_pair"] >= m]
        w = jj["plays_pair"]
        dse = np.average(jj["SE_base"] - jj["SE_pair"], weights=w) if len(jj) else np.nan
        print(f"{returner:16s} min-pairs {m:4d}  servers={len(jj):3d}  plays={int(w.sum()):7d}  DSE={dse:6.3f}")

dse_vs_threshold("Novak Djokovic")
dse_vs_threshold("Carlos Alcaraz")

def component_breakdown(returner):
    base = (serve_df.groupby(["server","serve_num"])
             .agg(plays=("is_win","size"),
                  ace_rate=("ace","mean"),
                  unret_rate=("unret","mean"),
                  sp1_rate=("sp_plus1","mean"))
             .assign(ace_rate=lambda d:100*d.ace_rate,
                     unret_rate=lambda d:100*d.unret_rate,
                     sp1_rate=lambda d:100*d.sp1_rate))
    pair = (serve_df[serve_df["returner"]==returner]
             .groupby(["server","serve_num"])
             .agg(plays_pair=("is_win","size"),
                  ace=("ace","sum"),
                  unret=("unret","sum"),
                  sp1=("sp_plus1","sum"))
             .assign(ace_pair=lambda d:100*d.ace/d.plays_pair,
                     unret_pair=lambda d:100*d.unret/d.plays_pair,
                     sp1_pair=lambda d:100*d.sp1/d.plays_pair))
    j = pair.join(base, how="inner")
    j["w"] = j["plays_pair"]
    for k in ["ace","unret","sp1"]:
        j[f"d_{k}"] = j[f"{k}_rate"] - j[f"{k}_pair"]
    out = j.groupby("serve_num").apply(
        lambda g: pd.Series({
            "servers": g.shape[0],
            "plays": int(g["w"].sum()),
            "Δace": np.average(g["d_ace"],   weights=g["w"]),
            "Δunret": np.average(g["d_unret"], weights=g["w"]),
            "Δsp1": np.average(g["d_sp1"],   weights=g["w"]),
        })
    )
    print(f"\nComponent deltas by serve number – {returner}")
    print(out.round(3))

component_breakdown("Novak Djokovic")
component_breakdown("Carlos Alcaraz")

# DIFFERENT DSE CALCULATIONS 
Empirical-Bayes - Component DSE (your “a-DSE”: ace + unret + S+1)
# 1) baselines per (server, serve_num)
base = (serve_df
        .groupby(["server","serve_num"])
        .agg(plays_s=("is_win","size"),
             ace_s=("ace","sum"),
             unret_s=("unret","sum"),
             sp1_s=("sp_plus1","sum"))
        .assign(p_ace_s   = lambda d: d.ace_s   / d.plays_s,
                p_unret_s = lambda d: d.unret_s / d.plays_s,
                p_sp1_s   = lambda d: d.sp1_s   / d.plays_s))

# 2) pair stats
pair = (serve_df
        .groupby(["server","returner","serve_num"])
        .agg(plays=("is_win","size"),
             ace=("ace","sum"),
             unret=("unret","sum"),
             sp1=("sp_plus1","sum"))
        .reset_index())

# 3) join & Empirical-Bayes shrink toward server baselines
m = 400  # shrinkage strength (tunable; 200–600 works well)
j = pair.merge(base.reset_index(), on=["server","serve_num"], how="left")

for comp, s_mean in [("ace","p_ace_s"), ("unret","p_unret_s"), ("sp1","p_sp1_s")]:
    j[f"p_{comp}_pair"]  = j[comp] / j["plays"]
    # posterior mean of pair rate with Beta–Binomial prior centered on server mean
    j[f"p_{comp}_post"]  = (j[comp] + m*j[s_mean]) / (j["plays"] + m)
    # delta = baseline − pair (positive means the returner reduced the server’s rate)
    j[f"d_{comp}"]       = 100*(j[s_mean] - j[f"p_{comp}_post"])

# 4) information weight (tiny pairs get little mass; no hard threshold)
j["w_eff"] = j["plays"] * (j["plays"] / (j["plays"] + m))

# 5) returner-level a-DSE (component deltas summed, weighted)
j["d_sum"] = j["d_ace"] + j["d_unret"] + j["d_sp1"]
aDSE = (j.groupby("returner")
          .apply(lambda g: pd.Series({
              "pairs_used":    g.shape[0],
              "plays":         int(g["plays"].sum()),
              "aDSE":          np.average(g["d_sum"], weights=g["w_eff"]),
              "Δace":          np.average(g["d_ace"], weights=g["w_eff"]),
              "Δunret":        np.average(g["d_unret"], weights=g["w_eff"]),
              "Δsp1":          np.average(g["d_sp1"], weights=g["w_eff"]),
          }))
          .reset_index()
          .sort_values("aDSE", ascending=False))
aDSE
Full-point DSE
# point-level server win already exists as pts["server_win"] (0/1 int)
# build server baselines per (server, serve_num)
svr_pts = pts.copy()
svr_pts["serve_num"] = np.where(svr_pts["err1"].fillna("")=="", 1, 2)

baseP = (svr_pts.groupby(["server_name","serve_num"])
         .agg(plays_s=("server_win","size"),
              win_s=("server_win","sum"))
         .assign(p_s = lambda d: d.win_s / d.plays_s)
         .rename_axis(index={"server_name":"server"})
         .reset_index())

pairP = (svr_pts.groupby(["server_name","returner_name","serve_num"])
         .agg(plays=("server_win","size"),
              win=("server_win","sum"))
         .rename_axis(index={"server_name":"server","returner_name":"returner"})
         .reset_index())

mP = 600  # slightly larger shrink for full-point stability
jj = pairP.merge(baseP, on=["server","serve_num"], how="left")
jj["p_pair"] = jj["win"] / jj["plays"]
jj["p_post"] = (jj["win"] + mP*jj["p_s"]) / (jj["plays"] + mP)
jj["d_full"] = 100*(jj["p_s"] - jj["p_post"])
jj["w_eff"]  = jj["plays"] * (jj["plays"] / (jj["plays"] + mP))

DSE_full = (jj.groupby("returner")
              .apply(lambda g: pd.Series({
                  "pairs_used": g.shape[0],
                  "plays": int(g["plays"].sum()),
                  "DSE_full": np.average(g["d_full"], weights=g["w_eff"]),
              }))
              .reset_index()
              .sort_values("DSE_full", ascending=False))
DSE_full
Mixed-effects model
# RETURN + 1
# ─── RETURN + 1 RANKING ────────────────────────────────────────────────────

def is_return_plus1(shots):
    """
    shots[0] = serve (srv)
    shots[1] = return (ret)
    We count RP1 if EITHER:
      A) len == 3 and last shot is server forced error '#'
      B) len == 4 and last shot is returner winner '*'
    Everything else → not RP1.
    """
    if not shots or len(shots) < 3:
        return False

    # A) Immediate server forced error on their first rally shot
    if len(shots) == 3 and shots[-1].hitter == "srv" and shots[-1].out == "#":
        return True

    # B) Returner hits a winner on their next ball
    if len(shots) == 4 and shots[-1].hitter == "ret" and shots[-1].out == "*":
        return True

    return False

# Ensure we only evaluate on points where a return was actually played
pts["rtn_plus1"] = pts.apply(
    lambda r: bool(r.rtn_played) and is_return_plus1(r.shots),
    axis=1
)

pts["rtn_plus1"] = pts.apply(
  lambda r: r.rtn_played and is_return_plus1(r.shots), axis=1
)

rp1_rank = (
  pts.groupby("returner_name")
     .agg(
       returns = ("rtn_played","sum"),
       rp1_pts = ("rtn_plus1","sum"),
     )
     .query("returns >= 10000")
     .assign(rp1_rate = lambda d: 100*d.rp1_pts/d.returns)
     .sort_values("rp1_rate", ascending=False)
)

print(f"Top 20 Return + 1 performers")
print(rp1_rank.head(20))

# RP1 must be a subset of returns
assert ((pts["rtn_plus1"] == 1) & (pts["rtn_played"] == 0)).sum() == 0

# Should never collide with immediate-serve outcomes
if "is_unret" in pts.columns:
    assert ((pts["rtn_plus1"] == 1) & (pts["is_unret"] == 1)).sum() == 0
if "is_ace" in pts.columns:
    assert ((pts["rtn_plus1"] == 1) & (pts["is_ace"] == 1)).sum() == 0

print("RP1 share among returns:",
      round(100 * pts.loc[pts["rtn_played"] == 1, "rtn_plus1"].mean(), 3), "%")

# RETURN DIRECTION
# Cell 1 – RETURN DIRECTION  
# This cell computes the return direction and other return stats

if "err1" not in pts.columns:
    pts[["dir1","err1","out1"]] = pts["1st"].map(lex_serve).tolist()
    pts[["dir2","err2","out2"]] = pts["2nd"].map(lex_serve).tolist()
return_rows = []
for _, r in pts.iterrows():

    # skip aces / unreturned serves
    if not r.rtn_played:
        continue

    rtn = r.shots[1]                     # first shot by returner

    # ------- split the two-digit sector code -------
    sec = rtn.sector or ""               # "", "8", "17", …
    lat = sec[0] if len(sec) >= 1 else None      # 1-6  (lateral)
    dep = sec[1] if len(sec) >= 2 else None      # 7/8/9 (depth)
    # ----------------------------------------------

    # first-serve return unless the first serve carried an error code
    serve_num = 1 if r.err1 == "" else 2

    return_rows.append({
        "match_id" : r.match_id,
        "returner" : r.player2 if r.server_name == r.player1 else r.player1,
        "server"   : r.server_name,
        "serve_num": serve_num,
        "side"     : r.side,
        "surface"  : r.Surface,
        "round"    : r.Round,
        "lat_sec"  : lat,
        "dep_sec"  : dep,
        "winner"   : rtn.out == "*",
        "unforced" : rtn.out == "@",
    })

return_df = pd.DataFrame(return_rows)

# Cell 2 – RETURN DIRECTION (label the two axes)

LATERAL_MAP = {
    "1": "fh_corner",      # right-hander’s FH / lefty BH
    "2": "middle",
    "3": "bh_corner",
    "4": "wide",
    "5": "body",
    "6": "T"
}

DEPTH_MAP = {
    "7": "shallow",
    "8": "deep",
    "9": "very_deep"
}

return_df["lat_bin"]   = return_df.lat_sec.map(LATERAL_MAP).fillna("unk")
return_df["depth_bin"] = return_df.dep_sec.map(DEPTH_MAP).fillna("unk")

# Cell 3 – RETURN DIRECTION (% table with both dimensions)
depth_order = ["shallow", "deep", "very_deep", "unk"]

rtn_dir_pct = (
    return_df
      .groupby([
          "returner", "serve_num", "side", "surface",
          "lat_bin", "depth_bin"              # ← two-level column index
      ])
      .size()
      .groupby(level=[0,1,2,3])               # total per (player,serve,side,surface)
      .apply(lambda s: 100*s/s.sum())         # convert to %
      .unstack(fill_value=0)
      .reindex(depth_order, axis = 1)                                # columns = lat × depth
)

# example slice: Novak Djokovic, vs 1st serves, deuce side, all surfaces
rtn_dir_pct.xs(("Novak Djokovic", 1, "deuce"), level=[0,1,2])

# Cell 4 – RETURN DIRECTION (player-specific % table)
player_return_query = (
    return_df.query("returner == 'Novak Djokovic'")
             .groupby(["lat_bin", "depth_bin"])
             .size()
)

pct_global = 100 * player_return_query / player_return_query.sum()        # ONE denominator
pct_global = (
    pct_global.unstack(fill_value=0)
              .reindex(depth_order, axis=1)     # keep column order
)

pct_global.index = (
    pd.MultiIndex.from_product(
        [["Novak Djokovic"], pct_global.index],   # top = player, 2nd = lat_bin
        names=["player", "lat_bin"]
    )
)

pct_global

Full table
rtn_dir_pct = rtn_dir_pct.reindex(depth_order, axis=1, level=1)
rtn_dir_pct
RANKING VERY-DEEP RETURNS


# ─── PARAMETERS ───
MIN_RETURNS = 10000     # only keep players with ≥ this many returns
DEPTH_FILTER = "very_deep"    # which depth to rank on
LAT_ORDER = ["bh_corner","fh_corner","middle","unk"]

# ─── 1. Totals per player ───
tot = (
    return_df
      .groupby("returner")
      .size()
      .rename("total_returns")
)

# ─── 2. Subset to the target depth ───
vd = return_df[return_df.depth_bin == DEPTH_FILTER]

# 2a) count of very_deep returns per player
tot_vd = vd.groupby("returner").size().rename(f"{DEPTH_FILTER}_count")

# 2b) breakdown of those very_deep by lat_bin
vd_lat = (
    vd.groupby(["returner","lat_bin"])
      .size()
      .unstack(fill_value=0)
      .reindex(columns=LAT_ORDER, fill_value=0)
)

# ─── 3. Assemble into one DataFrame ───
rank_df = pd.concat([tot, tot_vd, vd_lat], axis=1).fillna(0)

# ─── 4. Compute percentages of ALL returns ───
rank_df[f"{DEPTH_FILTER}_pct"] = 100 * rank_df[f"{DEPTH_FILTER}_count"] / rank_df["total_returns"]
for lat in LAT_ORDER:
    rank_df[f"{DEPTH_FILTER}_{lat}_pct"] = 100 * rank_df[lat] / rank_df["total_returns"]

# ─── 5. Filter by minimum returns ───
rank_df = rank_df[rank_df["total_returns"] >= MIN_RETURNS]

# ─── 6. Sort by the metric you care about ───
#    e.g. percent of *all* returns that were very_deep+middle:
rank_df = rank_df.sort_values(f"{DEPTH_FILTER}_middle_pct", ascending=False)

# ─── 7. Select & display columns ───
cols = [
    "total_returns",
    f"{DEPTH_FILTER}_count", f"{DEPTH_FILTER}_pct"
] + [f"{DEPTH_FILTER}_{lat}_pct" for lat in LAT_ORDER]

print(rank_df[cols].head(20))

# ERA ANALYSIS 
Cell 1 – Parse helpers
# --- final outcome of each point ------------------------------------------
def get_final_out(shots):
    """Return last Shot.out code (* # @) or None if shots missing."""
    if not isinstance(shots, list) or not shots:
        return None
    return shots[-1].out

# --- volley / net helpers --------------------------------------------------
NET_STROKES = set("vzophijkuy")        # volley, overhead, half-volley, etc.

def went_to_net(shots):
    """True if ANY volley-family stroke appears after the serve."""
    if not isinstance(shots, list):
        return False
    return any(s.stroke in NET_STROKES for s in shots[1:])

def is_sv_point(shots):
    """True if server’s 1st ground-stroke is a volley-family stroke."""
    if not isinstance(shots, list) or len(shots) < 3:
        return False
    first_ground = shots[2]
    return first_ground.hitter == "srv" and first_ground.stroke in NET_STROKES

Cell 2 – Add point-level flags to pts
# rally length (serve excluded); NaN if shots bad
pts["rally_len"] = pts["shots"].map(
    lambda s: len(s) - 1 if isinstance(s, list) else pd.NA
)

# final outcome flags
pts["final_out"]   = pts["shots"].map(get_final_out)
pts["is_winner"]   = pts["final_out"] == "*"
pts["is_forced"]   = pts["final_out"] == "#"
pts["is_unforced"] = pts["final_out"] == "@"

# net & serve-volley flags
pts["to_net"]  = pts["shots"].map(went_to_net)
pts["is_sv"]   = pts["shots"].map(is_sv_point)

# breakpoint flags (return-side)
sb = pts["score_bucket"].str.upper()
pts["is_bp"] = sb.isin({"0-40", "15-40", "30-40", "40-AD"})
pts["bp_won_flag"] = pts["is_bp"] & (pts["winner_name"] == pts["returner_name"])


# season column
pts["year"] = pts["match_id"].str.slice(0, 4).astype(int)

Cell 3 – Yearly aggregation table yearly
yearly = (
    pts.dropna(subset=["rally_len"])
       .groupby("year")
       .agg(
           pts_total      = ("rally_len", "size"),
           pct_net        = ("to_net",   "mean"),
           pct_sv         = ("is_sv",    "mean"),
           mean_rally     = ("rally_len","mean"),
           pct_win        = ("is_winner","mean"),
           pct_forced     = ("is_forced","mean"),
           pct_unforced   = ("is_unforced","mean"),
       )
       .assign(   # convert proportions → %
           pct_net      = lambda d: 100*d.pct_net,
           pct_sv       = lambda d: 100*d.pct_sv,
           pct_win      = lambda d: 100*d.pct_win,
           pct_forced   = lambda d: 100*d.pct_forced,
           pct_unforced = lambda d: 100*d.pct_unforced,
       )
)

