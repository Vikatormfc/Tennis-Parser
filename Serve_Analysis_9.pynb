By analysing the graphs, I decided to define eras pre 1990, 1990-2010, post 2010
def era_of(y: int) -> str:
    if y < 1990:   return "pre-1990"
    if y < 2011:   return "1990-2010"
    return "post-2010"

era_order = ["pre-1990", "1990-2010", "post-2010"]
era_dtype = pd.api.types.CategoricalDtype(era_order, ordered=True)

pts["era"] = pts["year"].map(era_of).astype(era_dtype)

Cell 6 – Era-level summary era_tbl
era_tbl = (
    pts.dropna(subset=["rally_len"])
       .groupby("era", observed=True)   # observed=True drops empty eras
       .agg(
           pts_total      = ("rally_len", "size"),
           pct_net        = ("to_net",    "mean"),
           pct_sv         = ("is_sv",     "mean"),
           mean_rally     = ("rally_len", "mean"),
           pct_win        = ("is_winner", "mean"),
           pct_forced     = ("is_forced", "mean"),
           pct_unforced   = ("is_unforced","mean"),
           bp_total       = ("is_bp",     "sum"),
           bp_won         = ("bp_won_flag","sum"),
       )
       .assign(
           pct_net      = lambda d: 100*d.pct_net,
           pct_sv       = lambda d: 100*d.pct_sv,
           pct_win      = lambda d: 100*d.pct_win,
           pct_forced   = lambda d: 100*d.pct_forced,
           pct_unforced = lambda d: 100*d.pct_unforced,
           bp_conv      = lambda d: 100*d.bp_won/d.bp_total,
       )
       .loc[:, ["pts_total","pct_net","pct_sv","mean_rally",
                "pct_win","pct_forced","pct_unforced","bp_conv"]]
)

print(era_tbl)

