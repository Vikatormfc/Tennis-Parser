# Testing DSE calculations
import numpy as np
import pandas as pd

# We already have: serve_df with columns ['server','returner','match_id','is_win', ...]
# If 'is_win' isn't present yet, run the line you had:
# serve_df["is_win"] = (serve_df["ace"] | serve_df["unret"] | serve_df["sp_plus1"]).astype(int)

# Pair- and base-level SE (same math as your DSE table)
base = (serve_df.groupby("server", observed=True)["is_win"]
                 .agg(wins="sum", plays="size")
                 .assign(SE_base=lambda d: 100*d.wins/d.plays)
                 [["SE_base"]])

pair = (serve_df.groupby(["server","returner"], observed=True)["is_win"]
                 .agg(wins="sum", plays="size")
                 .assign(SE_pair=lambda d: 100*d.wins/d.plays)
                 .join(base, on="server")
                 .assign(DSE=lambda d: d.SE_base - d.SE_pair)
                 .reset_index())

def compare_on_common(returners):
    sub = pair[pair["returner"].isin(returners)]
    common_servers = (sub.groupby("server")["returner"].nunique()
                        .pipe(lambda s: s[s == len(returners)]).index)
    cmp = sub[sub["server"].isin(common_servers)]
    out = (cmp.groupby("returner")
             .apply(lambda g: pd.Series({
                 "pairs_used_common": g.shape[0],
                 "plays_common": int(g["plays"].sum()),
                 "DSE_common": np.average(g["DSE"], weights=g["plays"])
             }))
             .reset_index()
           )
    return out.sort_values("DSE_common", ascending=False)

print(compare_on_common(["Novak Djokovic","Carlos Alcaraz","Roger Federer"]))

# Year from match_id
serve_df["year"] = pd.to_numeric(serve_df["match_id"].str[:4], errors="coerce")

base_y = (serve_df.groupby(["server","year"], observed=True)["is_win"]
                  .agg(wins="sum", plays="size")
                  .assign(SE_base_y=lambda d: 100*d.wins/d.plays)
                  [["SE_base_y"]]
                  .reset_index())

pair_y = (serve_df.groupby(["server","returner","year"], observed=True)["is_win"]
                  .agg(wins="sum", plays="size")
                  .assign(SE_pair_y=lambda d: 100*d.wins/d.plays)
                  .reset_index()
                  .merge(base_y, on=["server","year"], how="left")
                  .assign(DSE_y=lambda d: d.SE_base_y - d.SE_pair_y))

dse_year_matched = (pair_y.groupby("returner")
                           .apply(lambda g: pd.Series({
                               "pairs_used_years": g[["server","year"]].drop_duplicates().shape[0],
                               "plays": int(g["plays"].sum()),
                               "DSE_year_matched": np.average(g["DSE_y"], weights=g["plays"])
                           }))
                           .reset_index()
                           .sort_values("DSE_year_matched", ascending=False))

dse_year_matched.query("returner in ['Novak Djokovic','Carlos Alcaraz','Roger Federer']").head(10)

