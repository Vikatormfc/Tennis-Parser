Return + 1 ranking per era
# reusing rtn_plus1 flag from earlier answer
def is_return_plus1(shots):
    if not isinstance(shots, list):
        return False
    if len(shots) == 3:                   # forced error by server
        return shots[-1].hitter == "srv" and shots[-1].out == "#"
    if len(shots) == 4:                   # winner by returner
        return shots[-1].hitter == "ret" and shots[-1].out == "*"
    return False

pts["rtn_plus1"] = pts.apply(
    lambda r: r.rtn_played and is_return_plus1(r.shots), axis=1
)

rp1_era = (
    pts.groupby(["era", "returner_name"])
       .agg( returns=("rtn_played","sum"), rp1=("rtn_plus1","sum") )
       .query("returns >= 1")
       .assign(rp1_rate=lambda d: 100*d.rp1/d.returns)
       .sort_values(["era","rp1_rate"], ascending=[True,False])
)

for e in rp1_era.index.get_level_values(0).unique():
    print(f"\n=== Top 10 Return + 1 – {e} ===")
    print(rp1_era.xs(e).head(10)[["rp1_rate"]])

