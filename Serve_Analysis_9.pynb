# BUILDING PLAYER DASHBOARD
BLOCK A · helper columns
# ── helper to map PtWinner ↦ actual player name ―――――――――――――――――――
def winner_name(row):
    return row.player1 if row.PtWinner == "1" else row.player2

def loser_name(row):
    return row.player2 if row.PtWinner == "1" else row.player1

pts["winner_name"] = pts.apply(winner_name, axis=1)
pts["loser_name"]  = pts.apply(loser_name,  axis=1)

# did the server win this point?
pts["server_win"] = pts["winner_name"] == pts["server_name"]

# explode shots for YEAR_MIN+  (unchanged)
rows = []
for _, r in pts.query("year >= @YEAR_MIN").iterrows():
    srv = r.player1 if r.Svr else r.player2
    rtn = r.player2 if r.Svr else r.player1
    for idx, s in enumerate(r.shots or []):
        rows.append({
            "match_id"   : r.match_id,
            "year"       : r.year,
            "era"        : r.era,
            "surface"    : r.Surface,
            "stroke"     : s.stroke,
            "shot_idx"   : idx,
            "player"     : srv if s.hitter == "srv" else rtn,
            "final_winner": winner_name(r),          # NEW
            "pressure_pt": r.pressure_pt,
        })
shot_df = pd.DataFrame(rows)

# flag for “did THIS stroke’s striker win the rally?”
shot_df["win_point"] = shot_df["player"] == shot_df["final_winner"]

# keep only rally strokes (idx ≥ 1) and optional era filter
rally_shots = shot_df[shot_df.shot_idx > 0]
if ERA_FILTER:
    rally_shots = rally_shots.query("era == @ERA_FILTER")

# ==============================================================
# PLAYER ANALYTICS  –  one self-contained block
# ==============================================================


# --------------------------------------------------------------
# ── 0.  CONSTANTS
# --------------------------------------------------------------
MIN_TOTAL_PTS = 300
MIN_SLICE = 50
MIN_DROP  = 25
SLICE_CODES = {"s","r"}
DROP_CODES  = {"y","u"}
QUAL_CODES  = SLICE_CODES | DROP_CODES
NET_CODES   = {"v","z","o","p","h","i","j","k"}      # volleys-family

# --------------------------------------------------------------
# ── 1.  Slice / Drop attempt-scanner (full scan, corrected)
# --------------------------------------------------------------
rec_slice, rec_drop = [], []

for _, r in pts.iterrows():
    shots = r.shots or []
    if len(shots) < 3:                # need serve + return + 1
        continue

    name = lambda tag: r.player1 if (tag=="srv") == r.Svr else r.player2

    for i, sh in enumerate(shots[2:], start=2):          # start at idx 2
        if sh.stroke not in QUAL_CODES:
            continue

        hitter = name(sh.hitter)
        ok = False

        # idx itself winner *
        if sh.out == "*":
            ok = True

        # idx+1  opponent error (# or @)
        if i+1 < len(shots):
            nxt = shots[i+1]
            if nxt.hitter != sh.hitter and nxt.out in {"#","@"}:
                ok = True

        # idx+2  hitter winner *   (NOT #)
        if i+2 < len(shots):
            nxt2 = shots[i+2]
            if nxt2.hitter == sh.hitter and nxt2.out == "*":
                ok = True

        tgt = rec_slice if sh.stroke in SLICE_CODES else rec_drop
        tgt.append({"player": hitter, "succ": ok})

# helper → success table
def eff_tbl(rec, min_n):
    return (pd.DataFrame(rec)
              .groupby("player")
              .agg(plays=("succ","size"), succ=("succ","sum"))
              .query("plays >= @min_n")
              .assign(eff_pct=lambda d: 100*d.succ/d.plays))

slice_eff  = eff_tbl(rec_slice, MIN_SLICE)
drop_eff   = eff_tbl(rec_drop,  MIN_DROP)

# --------------------------------------------------------------
# ── 2.  Pressure-vs-normal win %  +  rally average  +  net use
# --------------------------------------------------------------
# build a long format: one row per player per point
long_pts = (
    pts.melt(
        id_vars=["match_id","pressure_pt","to_net","rally_len","winner_name"],
        value_vars=["player1","player2"],
        var_name="player_role",
        value_name="player"
    )
    .assign(win=lambda df: df.player == df.winner_name)
)

# aggregate per player
point_tbl = (
    long_pts.groupby("player")
        .agg(
            plays       = ("match_id","size"),
            wins        = ("win","sum"),
            press_plays = ("pressure_pt","sum"),
            press_wins  = ("win", lambda s: (s & long_pts.loc[s.index,"pressure_pt"]).sum()),
            net_plays   = ("to_net","sum"),
            net_wins    = ("win", lambda s: (s & long_pts.loc[s.index,"to_net"]).sum()),
            rally_avg   = ("rally_len","mean"),
        )
        .assign(
            win_pct       = lambda d: 100*d.wins/d.plays,
            press_win_pct = lambda d: 100*d.press_wins/d.press_plays,
            net_use_pct   = lambda d: 100*d.net_plays/d.plays,
            net_win_pct   = lambda d: 100*d.net_wins/d.net_plays,
        )
)


# --------------------------------------------------------------
# ── 3.  Offense / Defense / Consistency  (*rallies >= 4 only*)
# --------------------------------------------------------------
long_pts = pts.query("rally_len >= 4 and final_out.isin(['*','@'])")
long_pts["winner_name"] = np.where(long_pts.PtWinner=="1", long_pts.player1, long_pts.player2)

od = (
    long_pts.groupby("winner_name")
            .size().rename("winners")              # offense
    .to_frame()
    .join(long_pts.query("final_out=='@'")
                   .groupby("winner_name")
                   .size().rename("unforced"), how="outer")
    .fillna(0)
)
od["plays"]     = od.winners + od.unforced
od["win_rate"]  = 100*od.winners / od.plays
od["ue_rate"]   = 100*od.unforced / od.plays.replace(0, np.nan)
od["cons_ratio"]= od.win_rate / od.ue_rate.replace(0, np.nan)

# --------------------------------------------------------------
# ── 4.  Bring in previously-built serve / return tables
# --------------------------------------------------------------
# (serve_stats, return_stats, rp1_stats were already produced
#  from earlier cells – we just re-use them here.)
serve_stats = (
    serve_df
      .groupby("server")
      .agg(
        serve_total    = ("serve_num","size"),
        serve_aces     = ("ace",      "sum"),
        serve_unret    = ("unret",    "sum"),
        serve_sp1      = ("sp_plus1", "sum")
      )
      .assign(
        serve_ace_rate   = lambda d: 100*d.serve_aces  / d.serve_total,
        serve_unret_rate = lambda d: 100*d.serve_unret / d.serve_total,
        serve_sp1_rate   = lambda d: 100*d.serve_sp1   / d.serve_total,
        serve_SE         = lambda d:  d.serve_ace_rate
                               + d.serve_unret_rate
                               + d.serve_sp1_rate
      )
)



return_stats = (
    pts.query("rtn_played")
       .groupby("returner_name")
       .agg(
         ret_total    = ("rtn_played","size"),
         ret_wins     = ("rtn_winner","sum"),
         ret_unf      = ("rtn_unforce","sum")
       )
       .assign(
         ret_win_rate = lambda d: 100*d.ret_wins / d.ret_total,
         ret_err_rate = lambda d: 100*d.ret_unf  / d.ret_total
       )
)




rp1_stats = (
    pts.groupby("returner_name")
       .agg(
         rp1_total = ("rtn_played","sum"),
         rp1_pts   = ("rtn_plus1","sum")
       )
       .assign(
         rp1_rate = lambda d: 100*d.rp1_pts / d.rp1_total
       )
)
# --------------------------------------------------------------
# ── 5.  Assemble the dashboard
# --------------------------------------------------------------
idx = pd.Index(
  sorted(set(
    serve_stats.index
    ) | set(return_stats.index)
    | set(rp1_stats.index)
    | set(point_tbl.index)
    | set(od.index)
    | set(slice_eff.index)
    | set(drop_eff.index)
  ),
  name="player"
)

dash = (
    serve_stats.reindex(idx)
      .join(return_stats      .reindex(idx))
      .join(rp1_stats         .reindex(idx))
      .join(point_tbl         .reindex(idx))
      .join(od[['win_rate','ue_rate','cons_ratio']].reindex(idx))
      .join(slice_eff[['plays','eff_pct']].rename(columns=
             {"plays":"slice_plays","eff_pct":"slice_eff"}).reindex(idx))
      .join(drop_eff [['plays','eff_pct']].rename(columns=
             {"plays":"drop_plays","eff_pct":"drop_eff"}).reindex(idx))
      .fillna(0)
)

# filter low-sample players if you like
dash = dash.query("plays >= @MIN_TOTAL_PTS")

print(dash.head())

# save
dash.to_csv("player_dashboard.csv")

Query of players
