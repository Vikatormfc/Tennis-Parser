# 🗂 Data Loading & Initial Merge
# This notebook cell-by-cell loads the point files, concatenates them, merges match metadata, and shows each DataFrame head rendered in Markdown for clarity.
# %% [markdown]
# ## 1) Load points from GitHub (MCP) + set PtWinner from the last token

import pandas as pd
import re
import urllib.request

# --- MCP GitHub raw URLs ---
BASE = "https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/master/"
points_urls = [
    BASE + "charting-m-points-to-2009.csv",
    BASE + "charting-m-points-2010s.csv",
    BASE + "charting-m-points-2020s.csv",
]
# (for Block 2)
matches_url = BASE + "charting-m-matches.csv"

# ---- helpers ----
def url_lines(url: str):
    """Yield decoded lines from a GitHub raw URL."""
    with urllib.request.urlopen(url) as r:
        for b in r:
            yield b.decode("utf-8", errors="replace")

def pt_key(s: str) -> str:
    """Canonicalize Pt for joins (digits only), so '57', '57.0', ' 57 ' all match."""
    m = re.search(r"\d+", str(s))
    return m.group(0) if m else ""

def tail_ptwinner_map(url: str) -> pd.DataFrame:
    """
    Build a (match_id, Pt_key) -> PtWinner map from a raw file.
    It grabs:
      - match_id = text before the *first* comma
      - Pt       = text between the 1st and 2nd comma (then canonicalized)
      - PtWinner = text after the *last* comma
    Robust to tabs/commas in 1st/2nd/Notes.
    """
    recs = []
    for i, line in enumerate(url_lines(url)):
        if i == 0 and line.lower().startswith("match_id"):  # skip header
            continue
        s = line.rstrip("\r\n").replace("\t", ",")
        if not s: 
            continue
        c1 = s.find(",")
        if c1 == -1:
            continue
        c2 = s.find(",", c1 + 1)
        if c2 == -1:
            continue
        mid  = s[:c1].strip()
        pt_k = pt_key(s[c1+1:c2].strip())
        ptw  = s.rsplit(",", 1)[-1].strip()
        recs.append((mid, pt_k, ptw))
    df = pd.DataFrame(recs, columns=["match_id","Pt_key","PtWinner_tail"])
    return df.drop_duplicates(["match_id","Pt_key"], keep="last")

# 1) Read the three CSVs normally with pandas
dfs = [pd.read_csv(u, dtype=str, engine="python") for u in points_urls]
pts = pd.concat(dfs, ignore_index=True)
pts = pts[pts["match_id"] != "match_id"].copy()  # defensive

# 2) Overwrite PtWinner from the last token per line (joined on match_id + Pt_key)
pts["match_id"] = pts["match_id"].astype(str).str.strip()
pts["Pt_key"]   = pts["Pt"].astype(str).apply(pt_key)

ptw_map = pd.concat([tail_ptwinner_map(u) for u in points_urls], ignore_index=True)
ptw_map["match_id"] = ptw_map["match_id"].astype(str).str.strip()
ptw_map["Pt_key"]   = ptw_map["Pt_key"].astype(str)

# many-to-one merge guarantees we didn’t duplicate rows
before_n = len(pts)
pts = pts.merge(ptw_map, on=["match_id","Pt_key"], how="left", validate="many_to_one")
assert len(pts) == before_n

pts["PtWinner"] = pts["PtWinner_tail"].fillna(pts["PtWinner"]).astype(str).str.strip()
pts.drop(columns=["Pt_key","PtWinner_tail"], inplace=True)

# 3) Quick QA
valid_pw = pts["PtWinner"].isin({"1","2"})
print("Invalid PtWinner (expect ~0):", (~valid_pw).sum(), "/", len(pts))
pts.head()

# %% [markdown]
# ## 2. Identify Server and Basic Flags + Metadata + Big 3 QA

# 2.A matches lookup (names + metadata) — from GitHub (matches_url was set in Block 1)
matches = pd.read_csv(matches_url, dtype=str, engine="python")
matches["match_id"] = matches["match_id"].astype(str).str.strip()

# --- Deduplicate on match_id to satisfy many_to_one merges (keep last occurrence) ---
dup_ct = matches.duplicated("match_id", keep=False).sum()
if dup_ct:
    print(f"[warn] Duplicate match_id rows in matches: {dup_ct} → keeping last per match_id")
matches = matches.sort_values("match_id").drop_duplicates("match_id", keep="last")

# 2.B normalize TbSet & Svr to 0/1 ints
pts["TbSet"] = pts["TbSet"].map(lambda v: 1 if str(v).strip().upper() in {"1","TRUE"} else 0).astype("uint8")
pts["Svr"]   = pts["Svr"].map(lambda v: 1 if str(v).strip().upper() in {"1","TRUE"} else 0).astype("uint8")  # 1 ≙ Player1 served

# 2.C overwrite player1/player2 from matches (MCP truth)
name_map = matches[["match_id","Player 1","Player 2"]].rename(
    columns={"Player 1":"player1","Player 2":"player2"}
)
pts["match_id"] = pts["match_id"].astype(str).str.strip()
pts = (
    pts.drop(columns=["player1","player2"], errors="ignore")
       .merge(name_map, on="match_id", how="left", validate="many_to_one")
)

# 2.D per-point server/returner
pts["server_name"]   = pts.apply(lambda r: r.player1 if r.Svr == 1 else r.player2, axis=1)
pts["returner_name"] = pts.apply(lambda r: r.player2 if r.Svr == 1 else r.player1, axis=1)

# 2.E merge metadata (Surface/Round/Time if present)
meta_cols = ["match_id"] + [c for c in ["Surface","Round","Time"] if c in matches.columns]
pts = pts.merge(matches[meta_cols], on="match_id", how="left", validate="many_to_one")

# 2.F map server/returner hand
hand_map = (
    matches.rename(columns={"Player 1":"player1", "Player 2":"player2",
                            "Pl 1 hand":"hand1",  "Pl 2 hand":"hand2"})
           .melt(id_vars=["match_id","hand1","hand2"],
                 value_vars=["player1","player2"],
                 var_name="slot", value_name="player")
           .assign(server_hand=lambda df: np.where(df["slot"].eq("player1"), df["hand1"], df["hand2"]))
           .loc[:, ["match_id","player","server_hand"]]
           .drop_duplicates(["match_id","player"], keep="last")
)

# server hand
pts = pts.merge(
    hand_map, left_on=["match_id","server_name"], right_on=["match_id","player"],
    how="left", validate="many_to_one"
).drop(columns="player")

# returner hand
ret_hand_map = hand_map.rename(columns={"player":"returner","server_hand":"returner_hand"})
pts = pts.merge(
    ret_hand_map, left_on=["match_id","returner_name"], right_on=["match_id","returner"],
    how="left", validate="many_to_one"
).drop(columns="returner")

# 2.G validate PtWinner & derive winner/server_win
pts["PtWinner"] = pts["PtWinner"].astype(str).str.strip()
valid_pw        = pts["PtWinner"].isin({"1","2"})
print(f"Points with invalid PtWinner (not '1' or '2'): {(~valid_pw).sum()} / {len(pts)}")
if (~valid_pw).any():
    print("Sample rows with invalid PtWinner:")
    display(pts.loc[~valid_pw, ["match_id","Pt","PtWinner","1st","2nd","Notes"]].head(10))

pts["winner_name"] = np.where(pts["PtWinner"].eq("1"), pts["player1"],
                         np.where(pts["PtWinner"].eq("2"), pts["player2"], np.nan))
pts["server_win"]  = (pts["winner_name"] == pts["server_name"]).astype("uint8")

# 2.H Big-3 totals (independent of server)
def to_p1_served(x): return str(x).strip().upper() in {"1","TRUE","T"}

BIG3 = ["Novak Djokovic","Roger Federer","Rafael Nadal"]
rows = []
for name in BIG3:
    sub = pts[((pts["player1"]==name) | (pts["player2"]==name)) & valid_pw].copy()
    total = len(sub)
    won   = int((sub["winner_name"] == name).sum())
    pct   = won / total if total else np.nan

    svr_p1  = sub["Svr"].map(to_p1_served)
    p_is_p1 = (sub["player1"] == name)
    me_srv  = np.where(svr_p1, p_is_p1, ~p_is_p1)
    sp_pts  = int(me_srv.sum()); rp_pts = total - sp_pts
    sp_won  = int(((sub["winner_name"] == name) & me_srv).sum())
    rp_won  = int(((sub["winner_name"] == name) & (~me_srv)).sum())

    rows.append({
        "player": name,
        "points_won_total": won,
        "total_points_played": total,
        "overall_point_win_pct": pct,
        "serve_point_win_pct": (sp_won/sp_pts) if sp_pts else np.nan,
        "return_point_win_pct": (rp_won/rp_pts) if rp_pts else np.nan,
        "invalid_ptwinner_rows_excluded":
            int(((pts["player1"]==name) | (pts["player2"]==name)).sum() - total),
    })

big3 = pd.DataFrame(rows).sort_values("overall_point_win_pct", ascending=False)
display(big3[["player","points_won_total","total_points_played","overall_point_win_pct"]])
display(big3[["player","serve_point_win_pct","return_point_win_pct","invalid_ptwinner_rows_excluded"]])

# Global sanity
print("Global server-win (valid rows only):", pts.loc[valid_pw, "server_win"].mean())
first_pts = pts.sort_values(["match_id","Pt"]).groupby("match_id", as_index=False).head(1)
print("Share Pt==1 with Svr==1:", first_pts["Svr"].astype(str).str.upper().isin(["1","TRUE","T"]).mean())

