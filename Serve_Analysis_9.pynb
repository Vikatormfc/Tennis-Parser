missing = [p for p in players if p not in dash.index]
if missing:
    print("Warning: The following players are not present in the dashboard:", missing)

# Query dashboard stats for those who exist
subset = dash.loc[[p for p in players if p in dash.index]]

# Sort by a main indicator (example: Serve Efficiency or Consistency Ratio)
# Change 'serve_SE', 'win_pct', 'cons_ratio', etc. as you like
subset_sorted = subset.sort_values("cons_ratio", ascending=False)

# Display the result (all columns)
pd.set_option('display.max_columns', None)  # show all columns if wide
print(subset_sorted)
