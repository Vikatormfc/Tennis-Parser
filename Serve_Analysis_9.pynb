panel_c = (pair_c[pair_c["returner"].isin(TARGETS)]
           .groupby("returner")
           .apply(lambda g: pd.Series({
               "pairs_used": g.shape[0],
               "plays": int(g["plays"].sum()),
               "supp_ratio": np.average(g["supp_ratio"], weights=g["plays"])
           })).reset_index())

print("\nC) Early-phase suppression ratio (1 − SE_pair / SE_base):")
